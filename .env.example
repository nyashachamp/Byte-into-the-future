# Copy this file to .env and fill in your own values.
# .env is ignored by Git. Never commit real keys.

IBM_CLOUD_API_KEY=
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
WATSONX_URL=
ORCHESTRATE_API_KEY=
ORCHESTRATE_URL=

# Dashboard -> deployed orchestrator_agent (set as Code Engine secret/env vars)
# ORCHESTRATE_URL is the instance API URL, e.g.
# https://api.eu-gb.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
ORCHESTRATE_AGENT_ID=
# Optional: require a code before the public dashboard can trigger live runs
DASHBOARD_ACCESS_CODE=
